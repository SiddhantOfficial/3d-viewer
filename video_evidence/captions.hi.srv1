<?xml version="1.0" encoding="utf-8" ?><transcript><text start="0.43" dur="4.69">[संगीत]</text><text start="3.04" dur="3.2">छत्तीसगढ़ बहुत आते हैं ना तुलन</text><text start="5.12" dur="1.759">बहुत अच्छे आते हो</text><text start="6.24" dur="3.2">हां</text><text start="6.879" dur="4.161">है ना बहुत रोल में बोले थे अभी सिक्का</text><text start="9.44" dur="2.72">माला जानते थे ना सिक्का माला</text><text start="11.04" dur="2.8">हां</text><text start="12.16" dur="3.76">इतिहास पता है</text><text start="13.84" dur="4.24">नहीं मतलब इतिहास</text><text start="15.92" dur="4.64">ये जो फर्जी छत्तीसगढ़िया आवाद के पोल है</text><text start="18.08" dur="4.88">ना यहीं पे खुल जाते है मैं आप सब मन से</text><text start="20.56" dur="4.959">आग्रह करत हूं एक स्क्रीन में आऊं जो</text><text start="22.96" dur="4.079">मैसेज दिखाता हूं इन मैसेज ले दिखाओ यह</text><text start="25.519" dur="4.08">इंग्लिश में लिख के भेजे हैं आरजे</text><text start="27.039" dur="5.36">सिद्धार्थ शर्मा और हमला रिक्वेस्ट भेजी</text><text start="29.599" dur="5.841">से कि मोला आना है आप मन के शो में अगर</text><text start="32.399" dur="5.921">आपके पास स्पेस है तो दू अगर तेहा असली</text><text start="35.44" dur="6.88">छत्तीसगढ़ आदमी हरस तोला तो रिक्वेस्ट</text><text start="38.32" dur="8.16">छत्तीसगढ़ में भेज का भेजेस का फर्जी</text><text start="42.32" dur="7.919">वीडियो बना और जब हम टीम ला समय मिलस तब</text><text start="46.48" dur="7.84">वो समय ला सिद्धार्थ शर्मा ला दे से तब वो</text><text start="50.239" dur="7.601">सिद्ध शर्मा जो रही से वो जनला जिन हम</text><text start="54.32" dur="7.759">छत्तीसगढ़िया जो है हर कोई जानते वो जनला</text><text start="57.84" dur="6.399">के उत्तर वो नहीं दे और बहुत साधारण जनोला</text><text start="62.079" dur="4.481">में मैं पूछे हूं क्वेश्चन आप मन देखो</text><text start="64.239" dur="4.001">स्क्रीन मा एकदम साधारण क्वेश्चन रेवे</text><text start="66.56" dur="5.44">नानचक टुरी हम</text><text start="68.24" dur="6.16">कोचिया कोचिया के लुगरा पहने है</text><text start="72" dur="5.84">नानचक टुरी हम</text><text start="74.4" dur="6.96">कोचिया कोचिया के लुगरा पहने</text><text start="77.84" dur="5.76">लुगरा पहने</text><text start="81.36" dur="6.119">तीन ग की तितली हम</text><text start="83.6" dur="3.879">नहा खो के निकली</text><text start="88.88" dur="5.199">अब मोला का बता कि यहां छत्तीसगढ़ियावाद</text><text start="91.2" dur="4.8">के जो फर्जी छत्तीसगढ़वा जो बगरा थे वो</text><text start="94.079" dur="4">यहां पर आके हमारे पॉडकास्ट में पोक दी</text><text start="96" dur="5.36">नहीं जवाब दे पाई मोला मालूम ही नहीं रही</text><text start="98.079" dur="6.72">जैसे वो पडकास्ट अपलोड होस ओकर बाद में</text><text start="101.36" dur="6.399">सिद्धार्थ शर्मा हम चैनल मा द पीएस शो मा</text><text start="104.799" dur="5.201">स्ट्राइक दिस कैसे भी करके प्लान रही कि</text><text start="107.759" dur="5.04">हम द पीएस शो है ओला खत्म कर दिया जाए</text><text start="110" dur="5.6">काकर जो फर्जी छत्तीसगढ़िया वादे ओला हम</text><text start="112.799" dur="5.6">उजागर कर दे कुछ आए जाए नहीं वो पता चल</text><text start="115.6" dur="5.28">लोगन मन और लोगन ये सब चीज जैसे मालूम चली</text><text start="118.399" dur="6.441">से तो खूब गाली देला वो इंस्टा में दिखत</text><text start="120.88" dur="3.96">भी कमेंट में</text><text start="126.24" dur="5.44">आप जम्मू छत्तीसगढ़ मन जय राम जय जोहार जय</text><text start="128.959" dur="6.481">छत्तीसगढ़ मैं आपके होस्ट द पीएस शो के</text><text start="131.68" dur="6.08">रोहित सोनी और आज की जो एपिसोड है वो मा</text><text start="135.44" dur="5.2">कोई मैं गेस्ट नहीं ला हूं आप मन बल्कि</text><text start="137.76" dur="5.28">मैं खुद आज बोलैया हूं और मैं अपन दिल की</text><text start="140.64" dur="6.4">बात बोलत हूं जैसे कि आप मन जानत हो कि</text><text start="143.04" dur="6.08">छत्तीसगढ़ के जितका भी मन के जिन अलग अपन</text><text start="147.04" dur="5.36">जगह बनाए है ना सिर्फ छत्तीसगढ़ में बल्कि</text><text start="149.12" dur="6.72">देश में यहां तक के मैं भी कोशिश करता हूं</text><text start="152.4" dur="6.72">कि छत्तीसगढ़ के माटी ला छत्तीसगढ़ के</text><text start="155.84" dur="5.759">भइया ला जो अपन मिट्टी मान के काम करत है</text><text start="159.12" dur="5.839">उला मैं आगे बढ़ाऊं अपन शो के माध्यम से</text><text start="161.599" dur="6.961">आप मन बहुत मया दुलार दे द पीए शोला बहुत</text><text start="164.959" dur="6.321">कम समय मा हमन ग्रोथ का अभी तक के और आगे</text><text start="168.56" dur="6.08">भी आप मन के मया दुलार ऐसे बने रहे कि हम</text><text start="171.28" dur="5.76">आगे ग्रोथ कर लेकिन हम समझ पी कि असली</text><text start="174.64" dur="5.599">छत्तीसगढ़िया बात का चीज है और फर्जी</text><text start="177.04" dur="5.36">छत्तीसगढ़ियावाद का चीज है। मैं काबर बता</text><text start="180.239" dur="6.881">हूं काबर फर्जी छत्तीसगढ़िया बात के बात</text><text start="182.4" dur="7.919">करत हूं कि हम चैनल मा द पीए शो मा एक जन</text><text start="187.12" dur="5.68">रिक्वेस्ट करे से कि हम पडकास्ट भी आप मन</text><text start="190.319" dur="6">करो द पीएस शोला में ज्वाइन करना चाह तो</text><text start="192.8" dur="7.6">आप मन स्क्रीन में भी देख सकत हो आरजे</text><text start="196.319" dur="7.28">सिद्धांत शर्मा जे बकायदा हम इंस्टा में</text><text start="200.4" dur="7.199">मैसेज कर सवे और जब हम टीम ला समय मिलिस</text><text start="203.599" dur="6.801">तब वो समय ला सिद्ध शर्मा ला दे गरी से</text><text start="207.599" dur="5.681">लेकिन फर्जी जी छत्तीसगढ़ियावाद के जो</text><text start="210.4" dur="6.08">उदाहरण है वो मैं आप बताना चाहता हूं द</text><text start="213.28" dur="6.8">पडकास्ट शो जब चलत रही सब तब वो सिद्धार्थ</text><text start="216.48" dur="7.119">शर्मा जो रही से वो जनौला जिन हम</text><text start="220.08" dur="6.799">छत्तीसगढ़िया जो है हर कोई जानते वो जनला</text><text start="223.599" dur="5.041">के उत्तर वो नहीं दे पाई अब मोला का बता</text><text start="226.879" dur="4.241">कि यहां छत्तीसगढ़ियावाद के जो फर्जी</text><text start="228.64" dur="4.64">छत्तीसगढ़ियावाद जो बगरा थे वो यहां पे</text><text start="231.12" dur="4.72">आके हमारे पॉडकास्ट में पोक दी नहीं जवाब</text><text start="233.28" dur="5.519">दे पाई मोला मालूम ही नहीं रही अब वो यहां</text><text start="235.84" dur="6.72">पे आ के गड़बड़ कर डरी पोक डरिस गंदगी</text><text start="238.799" dur="6.961">फैला डरिस जैसे वो पडकास्ट अपलोड होस ओकर</text><text start="242.56" dur="6.239">बाद में सिद्धार्थ शर्मा हम चैनल मा द</text><text start="245.76" dur="5.679">पीएस शो मा स्ट्राइक दिस कैसे भी करके</text><text start="248.799" dur="5.841">प्लान से कि हम पीएस शो है ओला खत्म कर</text><text start="251.439" dur="5.92">दिया जाए काकर जो फर्जी छत्तीसगढ़ वाला हम</text><text start="254.64" dur="5.279">उजागर कर दे कुछ आए जाए नहीं वो पता चल</text><text start="257.359" dur="5.361">लोगन मन और लोगन मन ये सब चीज जैसे मालूम</text><text start="259.919" dur="6">चली से तो खूब गाली दे वो इंस्टा में दिखत</text><text start="262.72" dur="5.28">भी कमेंट में जब तोला छत्तीसगढ़ियावाद के</text><text start="265.919" dur="4.72">कोई आईडिया नहीं है</text><text start="268" dur="5.84">जा के सीख अगर ज्यादा छत्तीसगढ़ सीखना है</text><text start="270.639" dur="7.12">ना तो क्रांति सेना से सीख जा के कैसे</text><text start="273.84" dur="7.76">छत्तीसगढ़ बरा जाते जब यहां पे शो में आस</text><text start="277.759" dur="7.361">अपन हम तो नहीं बुला ना ते आस खुद से हम</text><text start="281.6" dur="8.24">रिक्वेस्ट करे हम रिक्वेस्ट करे ना तो जब</text><text start="285.12" dur="7.04">खुद आस हम शो मा और बहुत साधारण जनोला में</text><text start="289.84" dur="6.079">मैं पूछे हूं क्वेश्चन आप मन देख स्क्रीन</text><text start="292.16" dur="7.52">मा एकदम साधारण क्वेश्चन सब नाचक टुरी</text><text start="295.919" dur="6.161">कोचिया कोचिया लुगरा पहने हैं</text><text start="299.68" dur="5.84">नानचक टुरी हम</text><text start="302.08" dur="6.959">कोचिया कोचिया के लुगरा पहने</text><text start="305.52" dur="5.76">लुकरा पहने</text><text start="309.039" dur="6.121">तीन ग की तितली</text><text start="311.28" dur="3.88">नहा के निकली</text><text start="317.199" dur="7.361">जवाब नहीं दे पास तो उल्लू सीधा नहीं हो</text><text start="320.16" dur="7.039">से तो दूसरे के उल्लू का बिगाड़ भै</text><text start="324.56" dur="5.04">तो करे में कुछ नहीं हो जत का भी</text><text start="327.199" dur="5.121">छत्तीसगढ़िया मन है ना तो बता देता हूं</text><text start="329.6" dur="6">बाबू मैं ज भी छत्तीसगढ़िया मन है ना बहुत</text><text start="332.32" dur="6.719">सपोर्ट करे बहुत मया दे मन और ज का अभी तक</text><text start="335.6" dur="6.24">पडकास्ट करे ना मन उमा भी आप मन देख सकत</text><text start="339.039" dur="6">हो कि छत्तीसगढ़िया मन हम ज्यादा तवज्जो</text><text start="341.84" dur="6.079">दे तो असली छत्तीसगढ़ सीखना है तो जा के</text><text start="345.039" dur="6.241">छत्तीसगढ़िया क्रांति सेना सीख जिन मरे ख</text><text start="347.919" dur="5.681">तैयार हो जाते और ते अपन जीभ में आदमी</text><text start="351.28" dur="4.8">कंट्रोल नहीं रख सके खुद के बोले वाले बात</text><text start="353.6" dur="5.28">में कायम नहीं रह सके वो वो का</text><text start="356.08" dur="6.24">छत्तीसगढ़िया बात बरा वो हम चैनल में</text><text start="358.88" dur="6.48">स्ट्राइक दी से अब जवाब हम दे कुछ नहीं हो</text><text start="362.32" dur="5.84">हम चैनल में कुछ नहीं हो आप जितका भी देख</text><text start="365.36" dur="5.76">मन होना आप मन के प्यार और दुलार अतका है</text><text start="368.16" dur="5.039">आशीर्वाद अका है कि भगवान हां वो चैनल कुछ</text><text start="371.12" dur="4.48">नहीं होने दीजिए ये जो फर्जी छत्तीसगढ़िया</text><text start="373.199" dur="5.201">बात के पोल है ना यहीं पे खुल जात है मैं</text><text start="375.6" dur="6.159">आप सब मन से आग्रह करत हूं एक स्क्रीन में</text><text start="378.4" dur="6.32">आ जो मैसेज दिखा मैसेज दिखाओ ये इंग्लिश</text><text start="381.759" dur="5.601">में लिख के भेजे आर जे सिद्ध शर्मा अब हम</text><text start="384.72" dur="5.52">रिक्वेस्ट भेजी से कि मोला आना है आप मन</text><text start="387.36" dur="6.399">के शो में अगर आपके पास स्पेस है तो दू</text><text start="390.24" dur="7.44">अगर ते असली छत्तीसगढ़ आदमी हरस तोला तो</text><text start="393.759" dur="9.121">रिक्वेस्ट छत्तीसगढ़ में भेज का भेज का</text><text start="397.68" dur="8.799">फर्जी वीडियो बना द पीएस शो मा हमन जो</text><text start="402.88" dur="8.24">पडकास्ट कर बहुत मया दुलार से करन सब</text><text start="406.479" dur="7.681">कंटेंट जो थे वो कोई भी विवाद वो में नहीं</text><text start="411.12" dur="6.56">रखते कहीं भी वो कंटेंट मा आपला विवाद</text><text start="414.16" dur="8">नहीं दिखी सवाल पूछना एक होस्ट के फर्ज है</text><text start="417.68" dur="7.12">और जवाब देना जो गेस्ट हैकर फर्ज है लेकिन</text><text start="422.16" dur="5.28">तो बेइज्जती हो गई वो वीडियो मा और सबसे</text><text start="424.8" dur="6.239">बड़ी बात बतात हूं मैं हां आप मन ना एक</text><text start="427.44" dur="7.36">अनफिल्टर्ड एक वीडियो फॉर ऑडियो भी मैं</text><text start="431.039" dur="7.28">भेजूं देखो आप मन ये जनोला के जो दो</text><text start="434.8" dur="6.56">क्वेश्चन ना वो आंसर दे प मैं पडकास्ट ला</text><text start="438.319" dur="5.121">रोक के आंसर बता रहे हूं कि एक आंसर ये</text><text start="441.36" dur="5.76">होते तो यहां जवाब दे दे नहीं तो तो</text><text start="443.44" dur="6.319">बेइज्जती हो एक से बड़ा उदाहरण का हुई</text><text start="447.12" dur="6.16">फर्जी छत्तीसगढ़िया बात के आप मन बताओ अब</text><text start="449.759" dur="7.121">मैं तो बाहर से अवैया हूं लेकिन छत्तीसगढ़</text><text start="453.28" dur="5.44">मा पिछले 50 साल के हम परिवार के हिस्ट्री</text><text start="456.88" dur="4.08">जो है इतिहास है वो यहां पे और मैं</text><text start="458.72" dur="4.16">छत्तीसगढ़ के भया ला अपना हो छत्तीसगढ़ के</text><text start="460.96" dur="4.799">भाका ला अपनात हूं छत्तीसगढ़ के देवी</text><text start="462.88" dur="6.4">देवता मन अपना हो तो मोला नहीं लगत है कि</text><text start="465.759" dur="5.921">मोला कोई उदाहरण देगी या अपन आप साबित करे</text><text start="469.28" dur="4.8">पढ़ कि मैं छत्तीसगढ़ हूं लेकिन ते बाबू</text><text start="471.68" dur="6.16">थे छत्तीसगढ़ आदमी हरस का बात करता</text><text start="474.08" dur="6.64">छत्तीसगढ़ मा दिखा दे अपन सबूत ला मैं</text><text start="477.84" dur="4.72">दिखाऊं इंग्लिश में मैसेज भेज यहां आके</text><text start="480.72" dur="4.879">हिंदी में उठ</text><text start="482.56" dur="5.52">जवाब देना तो है नहीं अरे ते गड़बड़ी कर</text><text start="485.599" dur="5.44">डरे तो मैं का करूं तो पोल खुल गए तो भैया</text><text start="488.08" dur="5.839">मैं कुछ अलग कंटेंट तो नहीं दिखा जो ते</text><text start="491.039" dur="5.84">बोले हस वही दिखा मतलब</text><text start="493.919" dur="5.601">तो लगात सही नहीं बोले हस तो ठेका लेके</text><text start="496.879" dur="6">थोड़ी ना रख गनीत है और एक चीज है आप</text><text start="499.52" dur="6.56">जितका भी छत्तीसगढ़ मा जो इनफ्लुएंसरर मनो</text><text start="502.879" dur="6">आप मन से मैं निवेदन कर इसने आदमी ला अपन</text><text start="506.08" dur="6.079">पडकास्ट में बुला के अपन पडकास्ट के गरिमा</text><text start="508.879" dur="5.201">ला बिल्कुल आप मन ठेस मत पहुंचाओ कोई</text><text start="512.159" dur="4.88">जरूरत नहीं ऐसे आदमी ला अपन पडकास्ट में</text><text start="514.08" dur="6.16">बुला के बहुत मन के हवे हम छत्तीसगढ़ माला</text><text start="517.039" dur="6.641">आप मन मत बुलाओ बहुत जन हवे जे छत्तीसगढ़</text><text start="520.24" dur="6.32">संस्कृति परंपरा ला आगे बढ़ावत हवे ओकर आप</text><text start="523.68" dur="5.279">पडकास्ट लो जिला आप मन जानो ये फेक</text><text start="526.56" dur="6.32">छत्तीसगढ़ियावाद के जका भी जो आदमी मन है</text><text start="528.959" dur="6.56">ना उकर से आप मन बिल्कुल सचेत रहो और ओकर</text><text start="532.88" dur="4.88">वीडियो मा आप मन कमेंट करके बताओ और मैं</text><text start="535.519" dur="5.601">भी गलत लगत हूं ना अगर कोई भी पॉडकास्ट</text><text start="537.76" dur="5.199">में तो मोला बताओ कि मैं का गलती करे हूं</text><text start="541.12" dur="4.64">वो सिद्धार्थ शर्मा की पॉडकास्ट में मैं</text><text start="542.959" dur="5.681">अभी डिलीट नहीं करत हूं आप मन देखूं वहां</text><text start="545.76" dur="6.48">मैं जाके अगर कोई गलत सवाल मूढ़ान से अगर</text><text start="548.64" dur="5.84">मैं रखे हो अरे मजाक के पार्ट से तो अभी</text><text start="552.24" dur="4.56">नॉलेज नहीं है तो मैं का करूं ते बुक नहीं</text><text start="554.48" dur="4.24">पढ़े हस ते जानकार नहीं हस छत्तीसगढ़ के</text><text start="556.8" dur="4.08">बारे में जानत नहीं हस जनला का होते</text><text start="558.72" dur="5.44">सिक्का माला का होते तो पता नहीं फर्जी</text><text start="560.88" dur="5.68">छत्तीसगढ़िया बात बराबर बकरात बता दो मोला</text><text start="564.16" dur="4.32">सिक्का मालक क्वेश्चन पूछ रहे हो अकाम तो</text><text start="566.56" dur="4">चिड़ लग गए</text><text start="568.48" dur="5.44">पोल खुल गए तो चढ़ लग गए तो मैं का करूं</text><text start="570.56" dur="5.92">भैया मैं का करूं तो नहीं मालूम है तो अगर</text><text start="573.92" dur="5.359">मैं खुद से कहीं पे जाऊं अपन इंटरव्यू दूं</text><text start="576.48" dur="6.72">पडकास्ट दूं तो मो नॉलेज हुई तब मो देना</text><text start="579.279" dur="6.641">सही है आधा ज्ञान तो मो ले डूबी ना तो ते</text><text start="583.2" dur="5.12">बिना ज्ञान के का जास पडकास्ट शो में मैं</text><text start="585.92" dur="6.16">का करो बुराई नहीं करत हूं मैं आज बहुत</text><text start="588.32" dur="6.8">दिल से व्यथित हूं कमजोर नहीं</text><text start="592.08" dur="7.04">मैं आप मन पर एक से एक पडकास्ट शोला हूं।</text><text start="595.12" dur="7.2">आप मन बहुत पसंद करूं जेमा कोई विवाद के</text><text start="599.12" dur="6">जगह नहीं रही। मो पूरा विश्वास है यह जो</text><text start="602.32" dur="6.4">छोटी मानसिकता के लोगन मन थे ना उकर मन के</text><text start="605.12" dur="7.92">हरकत थे ये मोला वीडियो बहुत जरूरी बनाना</text><text start="608.72" dur="7.84">हम टीम का मेहनत करिस जम्मू पडकास्ट के हम</text><text start="613.04" dur="7.12">गेस्ट मन के लिए हम टीम मेहनत करते जतका</text><text start="616.56" dur="7.279">भी जन आए हम गेस्ट बन के अच्छा से जानत है</text><text start="620.16" dur="7.679">बहुत मया दुलार से यहां से जाते सब कुछ हम</text><text start="623.839" dur="5.921">जतका भी चीज हो सकते हो हम करन लेकिन हम</text><text start="627.839" dur="4.641">जो टीम है ना द पीएस शो</text><text start="629.76" dur="5.44">वो म बोली से कि आप एक वीडियो बनाना चाहिए</text><text start="632.48" dur="5.2">का बनाना चाहिए कि आप मन जितका भी ऑडियंस</text><text start="635.2" dur="5.759">मन हव वो ऑडियंस नहीं है मोर पर मोर</text><text start="637.68" dur="6">छत्तीसगढ़ के सबो जम्मो देखया मन मोर</text><text start="640.959" dur="5.44">परिवार हरे तो परिवार ला मैं नहीं बताऊं</text><text start="643.68" dur="7.04">तो कौन ला बताऊं तो परिवार ला म बताना</text><text start="646.399" dur="7.761">जरूरी है कि हम साथ एक फर्जी</text><text start="650.72" dur="7.119">छत्तीसगढ़ियावाद बढ़ावा करने वाले एक फेक</text><text start="654.16" dur="5.28">आदमी हम साथ का का करी सब हम शो में आके</text><text start="657.839" dur="4.641">उला मैं आप बता</text><text start="659.44" dur="7.6">उ सबसे बड़ी दिक्कत का हो पता है जब मैं</text><text start="662.48" dur="8.64">पडकास्ट में पूछे हूं कि ते हिंदी बोल तो</text><text start="667.04" dur="8.479">चल ज दूसरा हिंदी बोली तो तो दिक्कत है तो</text><text start="671.12" dur="7.2">पहले खुद तो अपन आप में कंठस्थ हो जा भाई</text><text start="675.519" dur="5.281">कि नहीं मैं जो बोलता हूं मैं मरत हूं अपन</text><text start="678.32" dur="7.12">सिद्धांतवादी आदमी रहा ना भैया छत्तीसगढ़</text><text start="680.8" dur="8.159">का सेना कैसे है अपन सिद्धांत में अत खुद</text><text start="685.44" dur="7.04">डामाडोल होतस मैं पूछे हूं सिद्धांत शर्मा</text><text start="688.959" dur="7.601">कि भाई आप मन वीडियो देखे हो और भी देख लो</text><text start="692.48" dur="6.32">स्क्रीन माला पूछे हो कि ते हिंदी बोल</text><text start="696.56" dur="5.2">सकतास लेकिन दूसरा मन हिंदी बोली तो</text><text start="698.8" dur="5.039">दिक्कत है का आप तो मान रहे हो ना कि आपको</text><text start="701.76" dur="4.8">अगर कमाना है आपकी आजीविका के लिए आपको</text><text start="703.839" dur="4.641">हिंदी तो बोलना पड़ेगा तो बाहर के लोग जो</text><text start="706.56" dur="3.76">हिंदी में बोल करके यहां काम कर रहे हैं</text><text start="708.48" dur="4.08">उनसे क्या आपत्ति भाई उनको क्यों आप</text><text start="710.32" dur="3.199">छत्तीसगढ़ भाषा बोलने के लिए इतना ज्यादा</text><text start="712.56" dur="1.6">प्रेशर डाल रहे हो</text><text start="713.519" dur="2.32">भाई दोनों</text><text start="714.16" dur="2.799">आप भी तो अपने कमाने के लिए हिंदी बोल ही</text><text start="715.839" dur="4.641">रहे हो ना</text><text start="716.959" dur="5.841">मैं मतलब कमाए हिंदी बोला तो मतलब</text><text start="720.48" dur="4.88">ये जो सिद्धार्थ शर्मा जो आवे ना अपन</text><text start="722.8" dur="4.56">प्रमोशनल वीडियो यानी कि कमाए पर हिंदी</text><text start="725.36" dur="4.24">में वीडियो बनाते खुद भी हमारे पडकास्ट</text><text start="727.36" dur="5.599">में बोली से कि म कमाना है तो म हिंदी</text><text start="729.6" dur="6.239">बोले पढ़ी तो ये तो डबल मापदंड हो गए जिन</text><text start="732.959" dur="5.361">अमित बघेल की थे दोहरा छत्तीसगढ़ बात के</text><text start="735.839" dur="5.361">बात हो गई तो कि म कमाना है तो मैं हिंदी</text><text start="738.32" dur="5.12">बोलूं नहीं तो मैं छत्तीसगढ़ बोलूं तो</text><text start="741.2" dur="5.199">छत्तीसगढ़ बोले में तो कमाई नहीं मिल हम</text><text start="743.44" dur="4.56">मिलत भाई द पीए में रेवेन्यू छत्तीसगढ़</text><text start="746.399" dur="5.361">बोले</text><text start="748" dur="6.8">अगर तो कमाना तो भी कुछ कर नहीं लेकिन</text><text start="751.76" dur="5.519">जबरदस्ती का करो काम बिगड़ाए के हरकत तो</text><text start="754.8" dur="6.08">शोभा नहीं देते छत्तीसगढ़ मन बहुत सरल और</text><text start="757.279" dur="7.12">सीधा होते हम अगर तो काम बिगाड़ते तो समझ</text><text start="760.88" dur="6.639">में आती अलग कंटेंट डाल के तो छवि खराब</text><text start="764.399" dur="6.721">करते तो समझ में आतीिस लेकिन हम तो ऐसे</text><text start="767.519" dur="7.201">कुछ नहीं करे जो पडकास्ट में ते आके यहां</text><text start="771.12" dur="6.88">पे गंदगी फैला हस वही ला दिखा दो ना मन कि</text><text start="774.72" dur="6.32">जे का का चीज मत ते फसे हस ये तो हर कोई</text><text start="778" dur="5.76">पडकास्ट के पॉलिसी के तरीका होवे में कहां</text><text start="781.04" dur="5.28">गलत हो गया ना मन अब यहां पे मैसेज</text><text start="783.76" dur="4.48">इंग्लिश में भेजत है कमाए पर हिंदी में</text><text start="786.32" dur="4.959">बोलत है और स्विट्जरलैंड में जाके</text><text start="788.24" dur="5.76">छत्तीसगढ़ के डिश मांग थे कि छत्तीसगढ़</text><text start="791.279" dur="5.12">कोई खाना हवे तो यहां पे प्रोवाइड कराओ</text><text start="794" dur="4.32">अरे अलक करा बोलता जी हां स्विट्जरलैंड</text><text start="796.399" dur="3.761">में छत्तीसगढ़ की डिश मिली तो छत्तीसगढ़</text><text start="798.32" dur="4.4">में स्विट्जरलैंड की डिश मिली का तो</text><text start="800.16" dur="7.119">पॉडकास्ट में आके काकरो पॉडकास्ट में आके</text><text start="802.72" dur="8.16">पडकास्ट में बहुत अलग है यह इंटरव्यू नो</text><text start="807.279" dur="6.321">तो बता हूं आर जे सिद्ध शर्मा तो मैं बता</text><text start="810.88" dur="5.68">हूं ये इंटरव्यू नो है भैया ते समझ</text><text start="813.6" dur="5.039">पडकास्ट मतलब समझ यहां मोला नहीं पता कत</text><text start="816.56" dur="5.2">का पढ़े हस तो हरकत तो नहीं लगत है पढ़े</text><text start="818.639" dur="6.401">लिखे जिसने बाकी तो देख ले अगर थोड़ा बहुत</text><text start="821.76" dur="6.56">तो जानकारी हुई पडकास्ट ला सर्च करके देख</text><text start="825.04" dur="5.919">ले बे क में मजाक मस्ती बिना विवाद के चीज</text><text start="828.32" dur="6.079">होते लेकिन मोर परिवार है छत्तीसगढ़ के सब</text><text start="830.959" dur="5.361">ज तो बता तो हरकत के बारे में आप मन</text><text start="834.399" dur="5.12">स्क्रीनशॉट दिखा देना मन हां</text><text start="836.32" dur="6.959">साजिश रही कि कैसे भी करके द पीएस शोला जो</text><text start="839.519" dur="5.76">है स्ट्राइक भेज करके इस चैनल बंद कर दे</text><text start="843.279" dur="6.481">लेकिन मैं बोले हूं ना आप मन के अतका मया</text><text start="845.279" dur="8.081">दुलार के सामने कोई भी पापी के ऐसे हरकत</text><text start="849.76" dur="7.439">सामने काम नहीं कर सके आप मन के मया दुलार</text><text start="853.36" dur="7.279">अतका बने हुए है कि सामने वो जो सिद्धांत</text><text start="857.199" dur="5.601">शर्मा के हरकत अपन हथियार डाल डरी से वो</text><text start="860.639" dur="4.161">बहुत कोशिश करी सब है लेकिन कुछ नहीं</text><text start="862.8" dur="3.44">बिगाड़ पाई सब वो आगे भी नहीं बिगाड़ पाए</text><text start="864.8" dur="4.24">ये भी बता देता</text><text start="866.24" dur="5.92">का कि आप मन के आशीर्वाद मैं दुलार जितका</text><text start="869.04" dur="6">भी छत्तीसगढ़ के सयान बुजुर्ग महिला</text><text start="872.16" dur="5.44">संगवारी मन के आशीर्वाद है तब तक तो ये</text><text start="875.04" dur="5.28">कुछ नहीं कर पाए और मैं जो भी बोलता हूं</text><text start="877.6" dur="5.039">अनफिल्टर्ड बोलता हूं और एक बात बता देता</text><text start="880.32" dur="7.199">हूं ये पडकास्ट की शूटिंग में बहुत देरी</text><text start="882.639" dur="8.481">लगी से आधा जानकारी थे ना कोई गेस्ट ला तब</text><text start="887.519" dur="6.401">फिर देरी लगते मैं हम नहीं बताना चाहिए</text><text start="891.12" dur="7.12">लेकिन ये जब अका गंदगी कर डरी से तब बताना</text><text start="893.92" dur="7.52">जरूरी है कि पडकास्ट शुरू करेवर बहुत</text><text start="898.24" dur="7.92">मुश्किल हो से तो छत्तीसगढ़ बोले ठीक से</text><text start="901.44" dur="8">नहीं आए पता नहीं क टेक लेके बोलत हो तो</text><text start="906.16" dur="6.479">मैं अनफिल्टर्ड ही हो आप मन भी पता हो कि</text><text start="909.44" dur="6.88">अनफिल्टर्ड शो हवे लेकिन एक शो में हमला</text><text start="912.639" dur="8.401">काट काट के डालना पड़ से का एक बेइज्जती</text><text start="916.32" dur="8.48">मत हो हम मन में कोई भावना नहीं लेकिन एक</text><text start="921.04" dur="6.56">जो भावना है षड्यंत्रकारी भावना है</text><text start="924.8" dur="4.88">कौन ला खत्म करना है कौन ला का करना है</text><text start="927.6" dur="6.239">ऐसे जो सोच रखने वाला होते ना छोटी</text><text start="929.68" dur="8.159">मानसिकता के ऊपर वाला के लाठी चलते ना कोई</text><text start="933.839" dur="6.641">नहीं बचे समझ गए ऊपर वाला के लाठी चली ना</text><text start="937.839" dur="5.44">तो नहीं बचते</text><text start="940.48" dur="6.56">वो लाठी से डर</text><text start="943.279" dur="7.68">ऐसे मत सोच हम डरत बस हम परिवार वाला मन</text><text start="947.04" dur="7.28">बतात ये तो हो गए एक ऐसे फेक छत्तीसगढ़िया</text><text start="950.959" dur="6.8">वाद जो बरा ओकर मन के खुलासा के बाद</text><text start="954.32" dur="6.24">एक्सपोज़र के बाद लेकिन मैं आप मनला हाथ</text><text start="957.759" dur="5.76">जोड़ के निवेदन करत हूं जतका मया दुलार आप</text><text start="960.56" dur="6.639">मन छत्तीसगढ़िया मन देत हो हमला द पीएस</text><text start="963.519" dur="5.76">शोला वने मया दुलार देत रहू हमन कोशिश कर</text><text start="967.199" dur="6">कि ऐसे</text><text start="969.279" dur="7.601">गेस हमन दोबारा कभी भी नहीं बुलाान हो सकी</text><text start="973.199" dur="7.121">तो हम जितका जन हवे जो पडकास्ट करते नवा</text><text start="976.88" dur="6.48">नवा इन्फ्लुएंसरर मन हवे मोर साथ में कोई</text><text start="980.32" dur="7.12">एक पडकास्ट आप नहीं दिखाई ताकि आप मन गुम</text><text start="983.36" dur="7.2">घूम रहा नहीं रहू लेकिन साथ में जो कई ऐसे</text><text start="987.44" dur="6.319">मन आवे जिन छत्तीसगढ़ में छाप छोड़े है ना</text><text start="990.56" dur="6.639">सिर्फ छत्तीसगढ़ में बल्कि देश मा ओला हम</text><text start="993.759" dur="7.361">आपला दिखात रहो ताकि आप मन आपन जिंदगी मा</text><text start="997.199" dur="7.2">दिन दुगनी रात चौगुनी तरक्की कर सको ओकर</text><text start="1001.12" dur="7.04">बारे में जान के जका भी देखया मन होना एक</text><text start="1004.399" dur="8.24">निवेदन है अगर आप मन मोर शो अच्छा लगते</text><text start="1008.16" dur="7.84">अगर आप मनला मोर शो से बहुत प्रेम है और</text><text start="1012.639" dur="6.401">मोर ग बात अच्छा लगते मोर जका गेस्ट मनाते</text><text start="1016" dur="5.44">ओकर ग बात आप अच्छा लगते और आपन सोचत हो</text><text start="1019.04" dur="5.36">कि मैं दिल से काम करत हो तो एक फेवर</text><text start="1021.44" dur="7.44">चाहिए अगर आपला लगत है कि मैं सही हूं तो</text><text start="1024.4" dur="6.799">कमेंट मा एक लाइन लिखना है बॉयकॉट फर्जी</text><text start="1028.88" dur="6.64">छत्तीसगढ़ियावाद</text><text start="1031.199" dur="8">ठीक है जतका आप मन कमेंट करू मो लगी कि आप</text><text start="1035.52" dur="5.919">मन मोर सपोर्ट में खड़े हो और आइसने आदमी</text><text start="1039.199" dur="5.12">मन के भी सपोर्ट नहीं करो ओकर भी बॉयकॉट</text><text start="1041.439" dur="6.081">करो तो आप जम्मो छत्तीसगढ़ मन मैं दिल से</text><text start="1044.319" dur="5.921">कहना चाहता हूं कि आप मन हम सपोर्ट करो का</text><text start="1047.52" dur="5.6">कि आप मन के प्रेम दुलार जो है हमला एक</text><text start="1050.24" dur="5.36">नवा एनर्जी दी नवा काम करे और हम शो के</text><text start="1053.12" dur="5.52">माध्यम से भी आप जमो छत्तीसगढ़िया मन के</text><text start="1055.6" dur="6.4">जिंदगी में सकारात्मक परिवर्तन आ सके ऐसे</text><text start="1058.64" dur="6.56">हम कोशिश आगे भी रही जय जोहार जय</text><text start="1062" dur="3.2">छत्तीसगढ़ जय राम</text></transcript>